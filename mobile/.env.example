# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API keys).
# Both values are public: they ship inside the app bundle, and RLS is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Google OAuth client IDs (public: they ship in the bundle and are not secrets).
# Google Cloud → APIs & Services → Credentials → Create OAuth client ID.
# The client *secret* belongs in the Supabase dashboard only, never in this repo.
#
# Web application. Supabase uses it, and every platform sends it as webClientId.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS, bundle ID com.sortirio.app. Its reversed form is also hardcoded in app.json
# as the google-signin plugin's iosUrlScheme — the native build needs it statically,
# so the two must be kept in sync.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Both client IDs must also be listed, comma-separated, in the Supabase dashboard:
# Authentication → Providers → Google → Client IDs, with "Skip nonce check" enabled.
