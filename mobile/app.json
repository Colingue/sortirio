{
  "expo": {
    "name": "sortirio",
    "slug": "sortirio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sortirio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.sortirio.app"
    },
    "android": {
      "package": "com.sortirio.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.450521523370-dfi7f7rtm2vdf0d74mpmcihqrudh8mk8"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sortirio utilise vos photos pour votre photo de profil, celle qui vous rend reconnaissable au bar.",
          "cameraPermission": "Sortirio utilise l'appareil photo pour prendre votre photo de profil, celle qui vous rend reconnaissable au bar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
